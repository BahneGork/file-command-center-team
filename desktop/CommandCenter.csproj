<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <AssemblyName>FileCommandCenter</AssemblyName>
    <RootNamespace>CommandCenter</RootNamespace>
    <!-- Eneste sted app-versionen sættes. Skal matche Version i installer\Package.wxs og git-tagget (vX.Y.Z) ved en udgivelse. -->
    <Version>1.0.5</Version>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Web.WebView2" Version="1.0.4191.47" />
  </ItemGroup>

  <!-- Siden er den samme index.html som PowerShell-versionen bruger (én kilde) -->
  <ItemGroup>
    <Content Include="..\index.html" Link="web\index.html" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
